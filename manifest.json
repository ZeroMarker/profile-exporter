{
  "manifest_version": 3,
  "name": "Profile Exporter",
  "version": "1.2.0",
  "description": "Export your following, likes, and favorites from X, Instagram, TikTok, Bilibili, YouTube, Weibo, Xiaohongshu, and Douyin.",
  "permissions": [
    "cookies",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://api.x.com/*",
    "https://x.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*",
    "https://www.youtube.com/*",
    "https://accounts.google.com/*",
    "https://weibo.com/*",
    "https://www.xiaohongshu.com/*",
    "https://edith.xiaohongshu.com/*",
    "https://www.douyin.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["background/xhs-inject.js"],
      "matches": ["https://www.xiaohongshu.com/*"]
    },
    {
      "resources": ["background/douyin-inject.js"],
      "matches": ["https://www.douyin.com/*"]
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["background/xhs-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["background/douyin-content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
